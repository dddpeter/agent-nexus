{{define "layout"}}<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nexus · {{.Title}}</title>
<link rel="stylesheet" href="/assets/system.css">
<script src="/assets/htmx.min.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="topbar-in">
    <a class="brand" href="/"><span class="brand-mark">N</span>Nexus</a>
    <nav class="nav">
      <a href="/" {{if eq .Active "agents"}}class="on"{{end}}>Agent</a>
      <a href="/agents/new" {{if eq .Active "wizard"}}class="on"{{end}}>注册</a>
      <a href="/chat" {{if eq .Active "chat"}}class="on"{{end}}>私聊</a>
    </nav>
    <div class="top-meta" id="top-meta" hx-get="/ui/topmeta" hx-trigger="every 15s" hx-swap="innerHTML">
      {{if .Meta}}{{template "topmeta" .Meta}}{{end}}
    </div>
  </div>
</header>
<main class="wrap">{{template "content" .V}}</main>
<footer class="wrap" style="padding-top:0">
  <div class="small muted" style="border-top:1px solid var(--line); padding-top:16px; display:flex; justify-content:space-between">
    <span>Nexus Agent Hub</span><span>内置调度器 · SQLite WAL</span>
  </div>
</footer>
<script>
// 相对时间渲染：data-ts="RFC3339"
function relTimeAll(root){
  (root||document).querySelectorAll('[data-ts]').forEach(function(el){
    var t=new Date(el.dataset.ts); if(isNaN(t))return;
    var s=(Date.now()-t.getTime())/1000, out;
    if(s<8) out='刚刚'; else if(s<60) out=Math.floor(s)+' 秒前';
    else if(s<3600) out=Math.floor(s/60)+' 分钟前';
    else if(s<86400) out=Math.floor(s/3600)+' 小时前';
    else out=Math.floor(s/86400)+' 天前';
    el.textContent=out; el.title=t.toLocaleString();
  });
}
document.addEventListener('DOMContentLoaded',function(){relTimeAll();});
document.body.addEventListener('htmx:afterSwap',function(e){relTimeAll(e.target);});
// 聊天消息区自动滚到底（首屏 + 局部刷新后）
function chatScrollBottom(){
  var el=document.getElementById('chat-messages');
  if(el) el.scrollTop=el.scrollHeight;
}
document.addEventListener('DOMContentLoaded',chatScrollBottom);
document.body.addEventListener('htmx:afterSwap',function(e){
  if(e.target.id==='chat-messages') requestAnimationFrame(chatScrollBottom);
});
</script>
</body>
</html>{{end}}

{{define "topmeta"}}<span>{{.Total}} agent · {{.Online}} 在线</span>{{end}}
