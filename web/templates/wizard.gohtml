{{define "content"}}
<div class="card">
  <h2 style="font-size:15px; margin:0 0 4px;">注册 Agent 向导</h2>
  <p class="hint">选 adapter → 动态配置表单（来自 adapter 的 ConfigSchema）→ 在线连通性测试 → 提交注册。</p>
  <form id="wizard" hx-post="/agents/new/test" hx-target="#test-result">
    <label>Agent 名字</label>
    <input type="text" name="name" placeholder="如 echod-main" required>

    <label>Adapter 类型</label>
    <select name="adapter" hx-get="/agents/new/config-form" hx-trigger="change" hx-target="#config-form" hx-include="this">
      {{range .V.Adapters}}<option value="{{.Name}}">{{.Name}}</option>{{end}}
    </select>

    <div id="config-form">
      {{if .V.InitialSchema}}{{template "config_form" .V.InitialSchema}}{{end}}
    </div>

    <label>能力参数（可选覆盖）</label>
    <div style="display:flex; gap:12px;">
      <div style="flex:1"><input type="number" name="cap_max_concurrency" placeholder="最大并发（默认 1）" min="1"></div>
      <div style="flex:1"><input type="number" name="cap_interrupt_level" placeholder="插话级别 0-2" min="0" max="2"></div>
      <div style="flex:1"><input type="number" name="cap_typical_latency_s" placeholder="典型延迟(秒)"></div>
    </div>
    <div class="hint">CanGroupChat / CanStream 取 adapter 默认值，可在注册后经 API 覆盖。</div>

    <button type="submit">测试连通性</button>
  </form>
  <div id="test-result"></div>

  <form id="submit-form" hx-post="/agents/new/submit" hx-target="#submit-result" hx-include="#wizard">
    <button type="submit">提交注册</button>
  </form>
  <div id="submit-result"></div>
</div>
{{end}}

{{define "config_form"}}
  {{range .Fields}}
    <label>{{.Label}} <span class="mono hint">({{.Name}}){{if .Secret}} · 密钥{{end}}{{if .Required}} · 必填{{end}}</span></label>
    {{if .Options}}
      <select name="cfg_{{.Name}}">
        {{range .Options}}<option value="{{.}}">{{.}}</option>{{end}}
      </select>
    {{else if eq .Type "bool"}}
      <select name="cfg_{{.Name}}">
        <option value="true">true</option>
        <option value="false">false</option>
      </select>
    {{else if eq .Type "int"}}
      <input type="number" name="cfg_{{.Name}}" value="{{.Default}}">
    {{else if eq .Type "list"}}
      <input type="text" name="cfg_{{.Name}}" placeholder="空格分隔的多值" value="{{.Default}}">
    {{else if .Secret}}
      <input type="password" name="cfg_{{.Name}}" placeholder="{{if .Default}}•••（留空保持）{{else}}密钥值{{end}}">
    {{else}}
      <input type="text" name="cfg_{{.Name}}" value="{{.Default}}">
    {{end}}
    {{if .Help}}<div class="hint">{{.Help}}</div>{{end}}
  {{end}}
{{end}}

{{define "test_result"}}
<div class="test-result">
  {{if .OK}}
    <span class="ok">✔ 连通性测试通过</span>（{{.DurationMs}} ms{{if .SentMessage}} · 含试发消息{{end}}）
  {{else}}
    <span class="bad">✘ 测试失败</span>（{{.DurationMs}} ms）：{{.Error}}
  {{end}}
</div>
{{end}}

{{define "submit_result"}}
<div class="test-result">
  {{if .OK}}
    <span class="ok">✔ 注册成功</span>：{{.Name}} → 状态 {{.Status}} · <a href="/">返回列表</a>
  {{else}}
    <span class="bad">✘ 注册失败</span>：{{.Error}}
  {{end}}
</div>
{{end}}
