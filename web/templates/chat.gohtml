{{define "content"}}
<div class="page-head">
  <div>
    <h1>私聊</h1>
    <div class="sub">与单个 agent 的 1v1 会话 · 回复经事件总线实时推送</div>
  </div>
</div>

<div class="chat-layout">
  <div class="card tight">
    <h2 class="card-title">会话<a class="small" href="/chat" style="font-weight:500">＋ 新会话</a></h2>
    {{if .Session}}
    <div class="sess-list" id="sess-list" style="padding:2px"
         hx-get="/ui/chat/sessions?current={{.Session.ID}}" hx-trigger="every 20s" hx-swap="innerHTML">
      {{template "chat_sessions" (chatSessionsData .Sessions .Session.ID)}}
    </div>
    {{else if .Agents}}
    <div style="padding:6px 4px 2px">
      <div class="f-hint" style="margin:0 0 8px">选择 agent 开始对话：</div>
      {{range .Agents}}
      <form method="post" action="/ui/chat/session" style="margin-bottom:6px">
        <input type="hidden" name="agent_id" value="{{.ID}}">
        <button class="btn btn-secondary" type="submit" style="width:100%;justify-content:space-between">
          <span>{{.Name}}</span><span class="st st-{{.Status}}" style="padding:0 6px">{{.Status}}</span>
        </button>
      </form>
      {{end}}
    </div>
    {{else}}
    <div class="empty" style="padding:28px 8px">
      <div class="big">还没有可用 agent</div>
      <a class="btn btn-primary" href="/agents/new">注册 Agent</a>
    </div>
    {{end}}
  </div>

  <div id="chat-root" data-session="{{if .Session}}{{.Session.ID}}{{end}}">
    {{if .Session}}
      {{template "chat_panel" .}}
    {{else}}
      <div class="card" style="height:560px;display:flex;align-items:center;justify-content:center">
        <div class="chat-empty">
          <div class="big" style="font-size:15px;font-weight:600;color:var(--ink-2);margin-bottom:4px">从左侧选择一个 agent</div>
          开始你的第一个私聊会话
        </div>
      </div>
    {{end}}
  </div>
</div>
{{end}}

{{define "chat_sessions"}}
{{range .Sessions}}
<a href="/chat?session={{.ID}}" class="{{if eq .ID $.CurrentID}}on{{end}}">
  <span style="font-weight:600">{{.AgentName}}</span>
  <span class="small muted" data-ts="{{formatTimeISOPtr .CreatedAt}}">{{formatTimeISOPtr .CreatedAt}}</span>
</a>
{{else}}
<div class="small muted" style="padding:6px 8px">暂无历史会话</div>
{{end}}
{{end}}

{{define "chat_panel"}}
<div class="card" style="padding:0;overflow:hidden">
  <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line)">
    <div style="display:flex;align-items:center;gap:8px">
      <b>{{.Agent.Name}}</b><span class="st st-{{.Agent.Status}}">{{.Agent.Status}}</span>
    </div>
    <span class="mono small muted">{{.Session.ID}}</span>
  </div>

  <div class="chat-box">
    <div class="chat-history" id="chat-messages"
         hx-get="/ui/chat/messages?session={{.Session.ID}}"
         hx-trigger="every 4s, refresh from:body, sse:msg.human, sse:msg.agent, sse:msg.system" hx-swap="innerHTML">
      {{template "chat_messages" (chatMessagesData .Messages "" .Session.ID)}}
    </div>
    <form id="chat-form" class="chat-input-bar"
          hx-post="/ui/chat/send" hx-target="#chat-messages" hx-swap="innerHTML">
      <input type="hidden" name="session_id" value="{{.Session.ID}}">
      <input class="f-input" id="chat-input" name="content" placeholder="输入消息，回车发送…" autocomplete="off" required>
      {{if .Agent.Capabilities.CanStream}}
      <button type="button" class="btn btn-secondary" id="chat-stream-btn" onclick="chatSendStream()">流式</button>
      {{end}}
      <button class="btn btn-primary" type="submit">发送</button>
    </form>
  </div>
</div>

<script>
function chatSendStream(){
  var root=document.getElementById('chat-root');
  var inp=document.getElementById('chat-input');
  var content=inp.value.trim();
  if(!content)return;
  inp.value='';
  var box=document.getElementById('chat-messages');
  appendBubble(box,'human',content);
  var agentBub=appendBubble(box,'agent','');
  var who=document.createElement('span');who.className='who';who.textContent='Agent';
  var typing=document.createElement('span');typing.className='typing';typing.innerHTML='<i></i><i></i><i></i>';
  agentBub.prepend(who);agentBub.appendChild(typing);
  fetch('/api/sessions/'+root.dataset.session+'/messages',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({content:content,mode:'stream'})
  }).then(function(resp){
    typing.remove();
    if(!resp.ok||!resp.body){agentBub.appendChild(document.createTextNode('流式发送失败：HTTP '+resp.status));return;}
    var reader=resp.body.getReader(),dec=new TextDecoder(),buf='';
    function pump(){
      reader.read().then(function(r){
        if(r.done){htmx.trigger(document.body,'refresh');return;}
        buf+=dec.decode(r.value,{stream:true});
        var idx;
        while((idx=buf.indexOf('\n\n'))>=0){
          var frame=buf.slice(0,idx);buf=buf.slice(idx+2);
          var line=frame.split('\n').find(function(l){return l.indexOf('data: ')===0;});
          if(!line)continue;
          var ev;try{ev=JSON.parse(line.slice(6));}catch(_){continue;}
          if(ev.type==='delta'||ev.type==='final')agentBub.appendChild(document.createTextNode(ev.data));
          if(ev.type==='error')agentBub.appendChild(document.createTextNode('[error] '+ev.data));
        }
        pump();
      });
    }
    pump();
  }).catch(function(err){typing.remove();agentBub.appendChild(document.createTextNode('[网络] '+err));});
}
function appendBubble(box,kind,text){
  var div=document.createElement('div');
  div.className='bubble '+kind;
  var who=document.createElement('span');who.className='who';
  who.textContent=kind==='human'?'你':'Agent';
  div.appendChild(who);
  div.appendChild(document.createTextNode(text));
  box.appendChild(div);
  box.scrollTop=box.scrollHeight;
  return div;
}
</script>
{{end}}

{{define "chat_messages"}}
{{if .Flash}}<div class="callout bad" style="margin:8px 12px">{{.Flash}}</div>{{end}}
<div class="chat-history-inner" style="display:flex;flex-direction:column;padding:4px 0">
  {{range .Messages}}
    <div class="bubble {{bubbleClass .SenderType}}">
      <span class="who">{{bubbleLabel .SenderType}} · {{.CreatedAt.Format "15:04:05"}}</span>{{.Content}}
    </div>
  {{else}}
    <div class="chat-empty">还没有消息，说点什么吧</div>
  {{end}}
</div>
{{end}}
