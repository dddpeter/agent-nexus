{{define "content"}}
<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2 style="font-size:15px; margin:0;">已注册 Agent</h2>
    <span class="hint">每 5 秒自动刷新 · <a href="/agents/new">注册新 Agent</a></span>
  </div>
  <div id="agents-table" hx-get="/agents/table" hx-trigger="every 5s" hx-swap="innerHTML">
    {{ template "agents_table" .V }}
  </div>
</div>
{{end}}

{{define "agents_table"}}
{{if .Flash}}<div class="test-result">{{.Flash}}</div>{{end}}
<table>
  <thead><tr>
    <th>名称</th><th>Adapter</th><th>状态</th><th>心跳</th><th>并发</th><th>能力</th><th>配置（脱敏）</th><th>操作</th>
  </tr></thead>
  <tbody>
  {{range .Agents}}
    <tr>
      <td><b>{{.Name}}</b><div class="hint mono">{{.ID}}</div></td>
      <td>{{.Adapter}}</td>
      <td><span class="badge {{.Status}}">{{.Status}}</span>{{if .Disabled}} <span class="badge removed">disabled</span>{{end}}</td>
      <td class="hint">{{if .LastHeartbeatAt}}{{formatTime .LastHeartbeatAt}}{{else}}-{{end}}</td>
      <td>{{.InFlight}}/{{.Capabilities.MaxConcurrency}}</td>
      <td class="hint">{{if .Capabilities.CanStream}}stream {{end}}{{if .Capabilities.CanGroupChat}}group{{end}}</td>
      <td class="mono hint">{{maskedConfig .Config}}</td>
      <td class="row-actions">
        <form hx-post="/ui/agents/{{.ID}}/test" hx-target="#agents-table" hx-swap="innerHTML">
          <button class="secondary" type="submit">测试</button>
        </form>
        {{if .Disabled}}
        <form hx-post="/ui/agents/{{.ID}}/enable" hx-target="#agents-table" hx-swap="innerHTML">
          <button class="secondary" type="submit">启用</button>
        </form>
        {{else}}
        <form hx-post="/ui/agents/{{.ID}}/disable" hx-target="#agents-table" hx-swap="innerHTML">
          <button class="secondary" type="submit">停用</button>
        </form>
        {{end}}
        <form hx-post="/ui/agents/{{.ID}}/delete" hx-confirm="软删除 {{.Name}}？历史会话保留。" hx-target="#agents-table" hx-swap="innerHTML">
          <button class="secondary" type="submit">软删</button>
        </form>
      </td>
    </tr>
  {{else}}
    <tr><td colspan="8" class="hint">暂无 agent —— 去 <a href="/agents/new">注册向导</a> 添加第一个 agent。</td></tr>
  {{end}}
  </tbody>
</table>
{{end}}
