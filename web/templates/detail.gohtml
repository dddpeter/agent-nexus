{{define "content"}}
<div class="page-head">
  <div class="detail-head">
    <div class="avatar">{{initial .Agent.Name}}</div>
    <div>
      <h1 style="display:flex;align-items:center;gap:10px">
        {{.Agent.Name}}
        <span class="st st-{{.Agent.Status}}">{{.Agent.Status}}</span>
        {{if .Agent.Disabled}}<span class="st st-disabled">停用</span>{{end}}
      </h1>
      <div class="sub mono">{{.Agent.ID}} · {{.Agent.Adapter}}</div>
    </div>
  </div>
  <div class="row-actions">
    {{if .Agent.Disabled}}
    <form hx-post="/ui/agents/{{.Agent.ID}}/enable" hx-target="#agent-ops-result" hx-swap="innerHTML">
      <button class="btn btn-secondary">启用</button>
    </form>
    {{else}}
    <form hx-post="/ui/agents/{{.Agent.ID}}/disable" hx-target="#agent-ops-result" hx-swap="innerHTML">
      <button class="btn btn-secondary">停用</button>
    </form>
    {{end}}
    <form hx-post="/ui/agents/{{.Agent.ID}}/delete"
          hx-confirm="软删除 {{.Agent.Name}}？历史会话与消息将保留。"
          hx-post="/ui/agents/{{.Agent.ID}}/delete">
      <button class="btn btn-secondary" style="color:var(--bad);border-color:#e8c2c2"
              hx-post="/ui/agents/{{.Agent.ID}}/delete">软删除</button>
    </form>
    <a class="btn btn-primary" href="/chat">发起私聊</a>
  </div>
</div>

<div class="grid" style="grid-template-columns: 1fr 340px; align-items:start">
  <div>
    <div class="card">
      <h2 class="card-title">配置
        <span class="small muted" style="font-weight:400">密钥字段回显脱敏 · 留空表示不修改</span>
      </h2>
      <div id="save-result"></div>
      <form id="edit-form" hx-post="/ui/agents/{{.Agent.ID}}/save" hx-target="#save-result" hx-swap="innerHTML">
        <div id="config-form">{{template "config_form" .SchemaVM}}</div>

        <h2 class="card-title" style="margin-top:22px">能力</h2>
        <div class="f-row">
          <div>
            <label class="f-label">最大并发</label>
            <input class="f-input" type="number" name="cap_max_concurrency" min="1"
                   value="{{.Agent.Capabilities.MaxConcurrency}}">
          </div>
          <div>
            <label class="f-label">插话级别（0-2）</label>
            <input class="f-input" type="number" name="cap_interrupt_level" min="0" max="2"
                   value="{{.Agent.Capabilities.InterruptLevel}}">
          </div>
          <div>
            <label class="f-label">可流式</label>
            <select class="f-input" name="cap_can_stream">
              <option value="true" {{if .Agent.Capabilities.CanStream}}selected{{end}}>是</option>
              <option value="false" {{if not .Agent.Capabilities.CanStream}}selected{{end}}>否</option>
            </select>
          </div>
        </div>
        <div class="f-hint">变更保存前自动做连通性测试；探活失败默认拒绝（坏配置不生效）。</div>

        <div style="display:flex;align-items:center;gap:14px;margin-top:18px">
          <button class="btn btn-primary" type="submit">保存变更</button>
          <label class="small muted" style="display:flex;align-items:center;gap:6px;margin:0">
            <input type="checkbox" name="force" value="true"> 强制保存（跳过探活拦截）
          </label>
        </div>
      </form>
    </div>
  </div>

  <div>
    <div class="card tight">
      <h2 class="card-title">运行信息
        <form hx-post="/ui/agents/{{.Agent.ID}}/test" hx-target="#test-result" hx-swap="innerHTML" class="row-actions">
          <button class="btn btn-secondary btn-sm" type="submit">测试连通性</button>
        </form>
      </h2>
      <dl class="kv" style="padding:4px 2px 8px">
        <dt>心跳</dt><dd data-ts="{{formatTimeISO .Agent.LastHeartbeatAt}}" class="muted">{{formatTimeISO .Agent.LastHeartbeatAt}}</dd>
        <dt>并发占用</dt><dd class="mono">{{.Agent.InFlight}} / {{.Agent.Capabilities.MaxConcurrency}}</dd>
        <dt>典型延迟</dt><dd>{{.Agent.Capabilities.TypicalLatency.D}}</dd>
        <dt>可群聊</dt><dd>{{if .Agent.Capabilities.CanGroupChat}}是{{else}}否{{end}}</dd>
      </dl>
      <div id="test-result"></div>
    </div>

    <div class="card tight" style="margin-top:16px">
      <h2 class="card-title">最近会话</h2>
      {{if .Sessions}}
      <div class="sess-list" style="padding:2px">
        {{range .Sessions}}
        <a href="/chat?session={{.ID}}">
          <span class="mono">{{.ID}}</span>
          <span class="small muted" data-ts="{{formatTimeISOPtr .CreatedAt}}">{{formatTimeISOPtr .CreatedAt}}</span>
        </a>
        {{end}}
      </div>
      {{else}}
      <div class="small muted" style="padding:8px 2px">还没有会话</div>
      {{end}}
    </div>
  </div>
</div>
<div id="agent-ops-result"></div>
{{end}}

{{define "save_result"}}
<div class="callout {{if .OK}}ok{{else}}bad{{end}}">
  {{if .OK}}✔ 已保存{{if .ProbeFailed}}（探活失败，agent 置为 offline 待恢复）{{end}}{{else}}✘ 保存被拒{{end}}
  <span class="detail">{{.Error}}</span>
</div>
{{end}}
