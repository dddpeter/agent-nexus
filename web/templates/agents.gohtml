{{define "content"}}
<div class="page-head">
  <div>
    <h1>Agent</h1>
    <div class="sub">被纳管的 agent 目录 · 状态由心跳探活自动维护</div>
  </div>
  <a class="btn btn-primary" href="/agents/new">注册 Agent</a>
</div>

<div id="agents-stats" hx-get="/ui/agents/stats" hx-trigger="sse:agent.status" hx-swap="innerHTML">
  {{template "agents_stats" .Stats}}
</div>

<div class="card" style="padding:6px 20px 10px">
  <div class="tbl-tools">
    <input class="f-input" type="search" name="q" placeholder="按名称、adapter 或状态过滤"
           hx-get="/agents/table" hx-trigger="input changed delay:300ms, search"
           hx-target="#agents-table" hx-include="this">
    <span class="small muted" id="tbl-count"></span>
  </div>
  <div id="agents-table"
       hx-get="/agents/table" hx-trigger="every 15s, sse:agent.status" hx-swap="innerHTML">
    {{template "agents_table" .}}
  </div>
</div>
{{end}}

{{define "agents_stats"}}
<div id="stats-oob" class="telemetry">{{template "agents_stats_cells" .}}</div>
{{end}}

{{define "agents_stats_cells"}}
  <div class="t"><div class="n">{{.Total}}</div><div class="l">已注册</div></div>
  <div class="t"><div class="n" style="color:var(--ok)">{{.Online}}</div><div class="l">在线</div></div>
  <div class="t bad"><div class="n">{{.Offline}}</div><div class="l">离线</div></div>
  <div class="t dim"><div class="n">{{.Removed}}</div><div class="l">停用 / 已删</div></div>
{{end}}

{{define "agents_table"}}
{{if .Flash}}<div class="callout {{if .FlashOK}}ok{{else}}bad{{end}}" style="margin:10px 0 4px">{{.Flash}}</div>{{end}}
<table class="tbl">
  <thead><tr>
    <th style="width:110px">状态</th><th>名称</th><th>Adapter</th><th>能力</th>
    <th style="width:70px">并发</th><th style="width:110px">心跳</th><th style="width:250px"></th>
  </tr></thead>
  <tbody>
  {{range .Agents}}
    <tr class="agent-row">
      <td><span class="st st-{{.Status}}">{{.Status}}</span>{{if .Disabled}} <span class="st st-disabled">停用</span>{{end}}</td>
      <td><a href="/agents/{{.ID}}/view" style="font-weight:600">{{.Name}}</a>
          <div class="mono muted">{{.ID}}</div></td>
      <td><span class="chip">{{.Adapter}}</span></td>
      <td class="small">
        {{if .Capabilities.CanStream}}<span class="chip on">流式</span>{{end}}
        {{if .Capabilities.CanGroupChat}}<span class="chip">群聊</span>{{end}}
        <span class="chip">插话 L{{.Capabilities.InterruptLevel}}</span>
      </td>
      <td class="mono">{{.InFlight}}/{{.Capabilities.MaxConcurrency}}</td>
      <td class="small muted" data-ts="{{formatTimeISO .LastHeartbeatAt}}">{{formatTimeISO .LastHeartbeatAt}}</td>
      <td>
        <div class="row-actions">
          <form hx-post="/ui/agents/{{.ID}}/test" hx-target="#agents-table" hx-swap="innerHTML" hx-disabled-elt="find button">
            <button class="btn btn-quiet btn-sm" type="submit">测试<span class="htmx-indicator spin"></span></button>
          </form>
          <a class="btn btn-quiet btn-sm" href="/agents/{{.ID}}/view">配置</a>
          {{if .Disabled}}
          <form hx-post="/ui/agents/{{.ID}}/enable" hx-target="#agents-table" hx-swap="innerHTML" hx-disabled-elt="find button">
            <button class="btn btn-quiet btn-sm" type="submit">启用</button>
          </form>
          {{else}}
          <form hx-post="/ui/agents/{{.ID}}/disable" hx-target="#agents-table" hx-swap="innerHTML" hx-disabled-elt="find button">
            <button class="btn btn-quiet btn-sm" type="submit">停用</button>
          </form>
          {{end}}
          <form hx-post="/ui/agents/{{.ID}}/delete" hx-confirm="软删除 {{.Name}}？历史会话与消息保留。" hx-target="#agents-table" hx-swap="innerHTML" hx-disabled-elt="find button">
            <button class="btn btn-danger btn-sm" type="submit">软删</button>
          </form>
        </div>
      </td>
    </tr>
  {{else}}
    {{if .Query}}
    <tr><td colspan="7">
      <div class="empty"><div class="big">没有匹配「{{.Query}}」的 agent</div><div>换个关键词，或清空过滤条件</div></div>
    </td></tr>
    {{else}}
    <tr><td colspan="7">
      <div class="empty">
        <div class="big">还没有注册任何 agent</div>
        <div>通过注册向导接入第一个 agent（echod / hermes / picoclaw）</div>
        <a class="btn btn-primary" href="/agents/new">注册 Agent</a>
      </div>
    </td></tr>
    {{end}}
  {{end}}
  </tbody>
</table>
{{end}}
